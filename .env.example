# PostgreSQL
POSTGRES_PASSWORD=change-me-strong-password

# Redis
REDIS_PASSWORD=change-me-redis-password

# Read replica host (optional — falls back to pgbouncer if not set)
# Set to your read-replica's hostname when using Postgres streaming replication
READ_DB_HOST=

# Salt for IP address hashing
IP_HASH_PEPPER=change-me-random-pepper-string

# Public URL of the app (used in email verification links)
BASE_URL=https://opentrafficdb.example.com

# Valhalla OSM tile URL (used on first boot to download map data)
VALHALLA_TILE_URL=https://download.geofabrik.de/europe/germany-latest.osm.pbf

# Base URL of the OpenTrafficRouting service (map matching and routing)
OTR_BASE_URL=http://localhost:8099

# App port (host)
APP_PORT=8095

# SMTP (leave SMTP_HOST empty to log emails to console in dev mode)
SMTP_HOST=
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_SSL=false
SMTP_FROM=opentrafficdb@example.com
SMTP_FROM_NAME=OpenTrafficDB

# Docker image of the app (set by CI, override for manual deploy)
APP_IMAGE=registry.gitlab.com/opentrafficdb/app:latest

# PostgreSQL memory tuning (defaults fit a host with ~8 GB RAM shared with other services)
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=2GB
PG_WORK_MEM=16MB
PG_MAINTENANCE_WORK_MEM=256MB
PG_WAL_BUFFERS=16MB

# Host port for pgbouncer (only needed for external DB access)
PGBOUNCER_PORT=26432

# MapTiler key for the map base style (https://cloud.maptiler.com/account/keys/)
MAPTILER_API_KEY=
