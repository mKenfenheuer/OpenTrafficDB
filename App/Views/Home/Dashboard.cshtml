@{
    ViewData["Title"] = "Dashboard";
}

<div id="loading" style="text-align:center;padding:80px 0">
    <div class="spinner"></div>
</div>

<div id="content" class="hidden">
    <div class="page-header">
        <div class="d-flex align-center justify-between flex-wrap gap-1">
            <div>
                <h1 id="greeting">Dashboard</h1>
                <p class="text-muted" id="subline">Your contribution overview</p>
            </div>
            <div id="role-display"></div>
        </div>
    </div>

    <div class="dash-grid">
        <!-- Left column: personal stats -->
        <div>
            <div class="card section">
                <div class="card-title">Your Account</div>
                <div style="display:flex;flex-direction:column;gap:10px;font-size:0.875rem">
                    <div class="d-flex justify-between">
                        <span class="text-muted">Name</span>
                        <span id="p-name" style="font-weight:500">—</span>
                    </div>
                    <div class="d-flex justify-between">
                        <span class="text-muted">Role</span>
                        <span id="p-role"></span>
                    </div>
                    <div class="d-flex justify-between">
                        <span class="text-muted">Member since</span>
                        <span id="p-created">—</span>
                    </div>
                </div>
                <div style="margin-top:16px">
                    <a href="/Home/Profile" class="btn btn-secondary btn-sm">Manage Profile &amp; API Keys</a>
                </div>
            </div>

            <div class="card section">
                <div class="card-title">Contributions</div>
                <div style="font-size:2.25rem;font-weight:800;line-height:1;margin-bottom:4px" id="p-contrib">—</div>
                <div class="text-muted text-sm">valid observations submitted</div>

                <div id="rank-progress-section" class="hidden" style="margin-top:16px">
                    <div class="d-flex justify-between text-sm mb-1">
                        <span class="text-muted">
                            Progress to
                            <span class="badge badge-contributor">Contributor</span>
                        </span>
                        <span id="rank-fraction"></span>
                    </div>
                    <div class="progress">
                        <div class="progress-bar" id="rank-bar" style="width:0%"></div>
                    </div>
                    <p class="text-sm text-muted mt-1"><span id="rank-remaining"></span> more observations needed</p>
                </div>
                <div id="rank-achieved" class="hidden" style="margin-top:12px">
                    <p class="text-sm text-muted">
                        You've reached Contributor rank or above. Thank you!
                    </p>
                </div>
            </div>
        </div>

        <!-- Right column: quick reference -->
        <div>
            <div class="card section">
                <div class="card-title">Machine Access Quick Reference</div>
                <p class="text-muted text-sm mb-2">Create API keys on your <a href="/Home/Profile">profile page</a>,
                    then:
                </p>
                <div class="code-block"><span class="code-comment"># Use your API key directly as the Bearer token</span>
<span class="code-comment"># Authorization: Bearer &lt;your-api-key&gt;</span>

<span class="code-comment"># Submit an observation</span>
<span class="code-url">POST /api/v1/speed</span>
<span class="code-key">{
    "tripId": "uuid",
    "latitude": 48.8566,
    "longitude": 2.3522,
    "speedMs": 13.9,
    "timestamp": "2024-01-01T12:00:00Z"
}</span>
<span class="code-comment"># Live traffic in bounding box</span>
<span class="code-url">GET /api/v1/traffic/live?minLat=…&amp;maxLat=…&amp;minLon=…&amp;maxLon=…</span>

<span class="code-comment"># Download predicted traffic CSV for Valhalla</span>
<span class="code-url">GET /api/v1/traffic/predicted/csv</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="module">
        import { getSession, logout, web, roleBadge, fmtDate } from '/js/app.js';
        window.logout = logout;

        const session = await getSession();
        if (!session) { window.location.href = '/'; throw new Error(); }

        document.getElementById('loading').classList.add('hidden');
        document.getElementById('content').classList.remove('hidden');

        // ── Profile ──────────────────────────────────────────────────────────────
        const threshold = session.totalContributions + session.contributionsToNextRank;
        const displayName = session.name || '(no name set)';

        document.getElementById('greeting').textContent = `Welcome back, ${displayName}`;
        document.getElementById('role-display').innerHTML = roleBadge(session.role);
        document.getElementById('p-name').textContent = displayName;
        document.getElementById('p-role').innerHTML = roleBadge(session.role);
        document.getElementById('p-created').textContent = fmtDate(session.createdAt);
        document.getElementById('p-contrib').textContent = session.totalContributions.toLocaleString();

        if (session.contributionsToNextRank > 0 && threshold > 0) {
            const pct = Math.min(100, (session.totalContributions / threshold) * 100);
            document.getElementById('rank-progress-section').classList.remove('hidden');
            document.getElementById('rank-fraction').textContent = `${session.totalContributions} / ${threshold}`;
            document.getElementById('rank-bar').style.width = pct + '%';
            document.getElementById('rank-remaining').textContent = session.contributionsToNextRank;
        } else {
            document.getElementById('rank-achieved').classList.remove('hidden');
        }
    </script>
}