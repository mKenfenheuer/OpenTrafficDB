@{
    ViewData["Title"] = "Admin";
}
<div id="loading" style="text-align:center;padding:80px 0">
      <div class="spinner"></div>
    </div>

    <div id="content" class="hidden">
      <div class="page-header">
        <h1>Admin Panel</h1>
        <p class="text-muted">Service statistics, user management, and IP controls</p>
      </div>

      <!-- Pipeline Stats -->
      <div class="section">
        <div class="section-title" style="display:flex;justify-content:space-between;align-items:center">
          <span style="display:flex;align-items:center;gap:8px">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            Aggregation Pipeline
          </span>
          <span id="stats-last-refresh" class="text-muted" style="font-size:0.78rem;font-weight:400"></span>
        </div>
        <div id="stats-container" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:10px">
          <div class="text-muted" style="padding:16px">Loading…</div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:10px">
          <div class="card" style="padding:14px 16px">
            <div style="font-size:0.72rem;color:var(--text-muted);text-transform:uppercase;letter-spacing:.04em;margin-bottom:8px">Queue sizes</div>
            <canvas id="chart-queues" height="80" style="width:100%"></canvas>
            <div style="display:flex;gap:12px;margin-top:6px;font-size:0.7rem;color:var(--text-muted)">
              <span><span style="color:#2f81f7">■</span> Total</span>
              <span><span style="color:#d29922">■</span> Matching</span>
              <span><span style="color:#a371f7">■</span> Aggregate</span>
            </div>
          </div>
          <div class="card" style="padding:14px 16px">
            <div style="font-size:0.72rem;color:var(--text-muted);text-transform:uppercase;letter-spacing:.04em;margin-bottom:8px">Throughput /min</div>
            <canvas id="chart-throughput" height="80" style="width:100%"></canvas>
            <div style="display:flex;gap:12px;margin-top:6px;font-size:0.7rem;color:var(--text-muted)">
              <span><span style="color:#3fb950">■</span> Ingest</span>
              <span><span style="color:#2f81f7">■</span> Processed</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Workers -->
      <div class="section">
        <div class="section-title" style="display:flex;justify-content:space-between;align-items:center">
          <span style="display:flex;align-items:center;gap:8px">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
            Worker Services
          </span>
          <span id="workers-last-refresh" class="text-muted" style="font-size:0.78rem;font-weight:400"></span>
        </div>
        <div id="workers-container">
          <div class="text-muted" style="padding:16px">Loading…</div>
        </div>
      </div>

      <!-- Users -->
      <div class="section">
        <div class="section-title d-flex justify-between align-center">
          <span style="display:flex;align-items:center;gap:8px">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
            Users
          </span>
          <button class="btn btn-secondary btn-sm" onclick="loadUsers()">Refresh</button>
        </div>
        <div class="card" style="padding:0;overflow:hidden">
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>ID</th><th>Name</th><th>Role</th><th>Contributions</th>
                  <th>Keys</th><th>Joined</th><th>Status</th><th>Actions</th>
                </tr>
              </thead>
              <tbody id="users-tbody">
                <tr><td colspan="8" class="text-muted" style="text-align:center;padding:24px">Loading…</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Keys drawer -->
      <div id="keys-drawer" class="hidden section">
        <div class="section-title d-flex justify-between align-center">
          <span id="keys-drawer-title">API Keys</span>
          <button class="btn btn-secondary btn-sm" onclick="closeKeysDrawer()">Close</button>
        </div>
        <div class="card" style="padding:0;overflow:hidden">
          <div class="table-wrap">
            <table>
              <thead>
                <tr><th>ID</th><th>Label</th><th>Created</th><th>Last used</th><th>Status</th><th>Actions</th></tr>
              </thead>
              <tbody id="keys-tbody"></tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Danger Zone -->
      <div class="section">
        <div class="section-title" style="color:var(--danger)">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          Danger Zone
        </div>
        <div class="card" style="border:1px solid var(--danger)">
          <div class="card-title" style="color:var(--danger)">Purge all traffic data</div>
          <p class="text-muted" style="margin-bottom:12px">
            Permanently deletes all speed observations, way aggregates, and way speed summaries.
            Resets all user contribution counters to zero. Geometries, users, and API keys are kept.
            <strong>This cannot be undone.</strong>
          </p>
          <div id="purge-alert" class="alert hidden"></div>
          <button class="btn btn-danger" onclick="purgeData()">Purge all traffic data</button>
        </div>
      </div>

      <!-- Blocked IPs -->
      <div class="section">
        <div class="section-title d-flex justify-between align-center">
          <span style="display:flex;align-items:center;gap:8px">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
            Blocked IPs
          </span>
          <button class="btn btn-secondary btn-sm" onclick="loadBlocked()">Refresh</button>
        </div>

        <div class="card mb-2">
          <div class="card-title" style="font-size:0.85rem">Block an IP</div>
          <div id="block-alert" class="alert hidden"></div>
          <div style="display:flex;gap:8px;flex-wrap:wrap">
            <input type="text"           id="block-ip"      class="form-control" placeholder="IP address"  style="max-width:200px">
            <input type="text"           id="block-reason"  class="form-control" placeholder="Reason"      style="flex:1;min-width:160px">
            <input type="datetime-local" id="block-expires" class="form-control"                           style="max-width:200px">
            <button class="btn btn-danger" onclick="blockIp()">Block</button>
          </div>
          <p class="text-sm text-muted mt-1">Leave expiry blank for a permanent block.</p>
        </div>

        <div class="card" style="padding:0;overflow:hidden">
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>ID</th><th>IP Hash (16 chars)</th><th>Reason</th>
                  <th>Type</th><th>Blocked at</th><th>Expires</th><th>Actions</th>
                </tr>
              </thead>
              <tbody id="blocked-tbody">
                <tr><td colspan="7" class="text-muted" style="text-align:center;padding:24px">Loading…</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
@section Scripts {
    
  <script type="module">
    import { getSession, logout, web, roleBadge, fmtDate, fmtDateTime, showAlert, esc } from '/js/app.js';
    window.logout = logout;

    const session = await getSession();
    if (!session)              { window.location.href = '/';             throw new Error(); }
    if (session.role !== 'Admin') { window.location.href = '/Home/Dashboard'; throw new Error(); }

    document.getElementById('loading').classList.add('hidden');
    document.getElementById('content').classList.remove('hidden');

    // ── Charts ─────────────────────────────────────────────────────────────────

    const HISTORY_MAX = 240;  // keep 240 samples (1 hour at 15 s interval)

    const history = {
      labels:       [],
      totalQueue:   [],
      matchQueue:   [],
      aggQueue:     [],
      ingestPerMin: [],
      procPerMin:   [],
    };

    function pushHistory(d) {
      const t = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
      history.labels      .push(t);
      history.totalQueue  .push(d.totalQueue);
      history.matchQueue  .push(d.matchingQueue);
      history.aggQueue    .push(d.aggregateQueue);
      history.ingestPerMin.push(d.ingestPerMin);
      history.procPerMin  .push(d.processedPerMin);
      for (const k of Object.keys(history))
        if (history[k].length > HISTORY_MAX) history[k].shift();
    }

    function drawChart(canvasId, series, colors) {
      const canvas = document.getElementById(canvasId);
      if (!canvas) return;
      const dpr = window.devicePixelRatio || 1;
      const w   = canvas.clientWidth;
      const h   = canvas.clientHeight;
      if (!w || !h) return;
      canvas.width  = w * dpr;
      canvas.height = h * dpr;
      const ctx = canvas.getContext('2d');
      ctx.scale(dpr, dpr);

      const pad = { top: 4, right: 4, bottom: 18, left: 38 };
      const pw  = w - pad.left - pad.right;
      const ph  = h - pad.top  - pad.bottom;
      const n   = history.labels.length;
      if (n < 2) { ctx.fillStyle = 'rgba(139,148,158,0.3)'; ctx.fillRect(pad.left, pad.top, pw, ph); return; }

      const allVals = series.flatMap(s => s);
      const maxVal  = Math.max(...allVals, 1);
      const step    = pw / (n - 1);

      // grid lines
      ctx.strokeStyle = 'rgba(48,54,61,0.8)';
      ctx.lineWidth   = 1;
      for (let i = 0; i <= 4; i++) {
        const y = pad.top + ph * (1 - i / 4);
        ctx.beginPath(); ctx.moveTo(pad.left, y); ctx.lineTo(pad.left + pw, y); ctx.stroke();
        ctx.fillStyle = '#8b949e';
        ctx.font      = `${Math.round(9 * dpr) / dpr}px sans-serif`;
        ctx.textAlign = 'right';
        ctx.fillText(Math.round(maxVal * i / 4).toLocaleString(), pad.left - 4, y + 3);
      }

      // x-axis labels (first, middle, last)
      ctx.fillStyle = '#8b949e';
      ctx.font      = `${Math.round(9 * dpr) / dpr}px sans-serif`;
      ctx.textAlign = 'center';
      const lblIdxs = [0, Math.floor((n - 1) / 2), n - 1];
      for (const i of lblIdxs) {
        const x = pad.left + i * step;
        ctx.fillText(history.labels[i], x, h - 3);
      }

      // series lines
      series.forEach((vals, si) => {
        ctx.strokeStyle = colors[si];
        ctx.lineWidth   = 1.5;
        ctx.lineJoin    = 'round';
        ctx.beginPath();
        vals.forEach((v, i) => {
          const x = pad.left + i * step;
          const y = pad.top + ph * (1 - v / maxVal);
          i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
        });
        ctx.stroke();
      });
    }

    function redrawCharts() {
      drawChart('chart-queues',     [history.totalQueue, history.matchQueue, history.aggQueue], ['#2f81f7', '#d29922', '#a371f7']);
      drawChart('chart-throughput', [history.ingestPerMin, history.procPerMin],                ['#3fb950', '#2f81f7']);
    }

    // Redraw on resize so the canvas fills its container correctly.
    window.addEventListener('resize', redrawCharts);

    // ── Seed history from server ───────────────────────────────────────────────

    async function seedHistory() {
      const res = await web('GET', '/admin/stats/history');
      if (!res?.ok || !res.data.length) return;
      for (const s of res.data) {
        const t = new Date(s.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
        history.labels      .push(t);
        history.totalQueue  .push(s.totalQueue);
        history.matchQueue  .push(s.matchingQueue);
        history.aggQueue    .push(s.aggregateQueue);
        history.ingestPerMin.push(s.ingestPerMin);
        history.procPerMin  .push(s.processedPerMin);
      }
      redrawCharts();
    }

    // ── Pipeline Stats ─────────────────────────────────────────────────────────

    function statKpi(label, value, sub = '', cls = '') {
      return `<div class="card" style="padding:14px 16px">
        <div style="font-size:0.72rem;color:var(--text-muted);text-transform:uppercase;letter-spacing:.04em;margin-bottom:4px">${label}</div>
        <div style="font-size:1.5rem;font-weight:700${cls ? `;color:var(--${cls})` : ''}">${value}</div>
        ${sub ? `<div style="font-size:0.75rem;color:var(--text-muted);margin-top:2px">${sub}</div>` : ''}
      </div>`;
    }

    async function loadStats() {
      const res = await web('GET', '/admin/stats');
      const container = document.getElementById('stats-container');
      if (!res?.ok) {
        container.innerHTML = '<div class="text-danger" style="padding:12px">Failed to load stats.</div>';
        return;
      }
      const d = res.data;
      const queueCls = d.totalQueue > 500_000 ? 'danger' : d.totalQueue > 100_000 ? 'warning' : '';
      container.innerHTML =
        statKpi('Total queue',      d.totalQueue.toLocaleString(),      'unmatched or unaggregated', queueCls) +
        statKpi('Matching queue',   d.matchingQueue.toLocaleString(),   'no OSM way yet') +
        statKpi('Aggregate queue',  d.aggregateQueue.toLocaleString(),  'matched, pending agg.') +
        statKpi('Ingest rate',      d.ingestPerMin.toLocaleString() + ' /min', `${d.ingestPer5Min.toLocaleString()} in last 5 min`) +
        statKpi('Processing rate',  d.processedPerMin.toLocaleString() + ' /min', `${d.processedPer5Min.toLocaleString()} aggregated last 5 min`);
      document.getElementById('stats-last-refresh').textContent = 'Updated ' + new Date().toLocaleTimeString();
      pushHistory(d);
      redrawCharts();
    }

    // ── Workers ────────────────────────────────────────────────────────────────

    const STATUS_COLOR = { Healthy: 'success', Degraded: 'warning', Unhealthy: 'danger', Unknown: 'muted' };
    const STATUS_DOT   = { Healthy: '●', Degraded: '◑', Unhealthy: '●', Unknown: '○' };

    function fmtMs(v) {
      if (v == null) return '—';
      return v < 1000 ? `${v} ms` : `${(v/1000).toFixed(2)} s`;
    }

    function workerKpi(label, value, cls = '') {
      return `<div style="text-align:center">
        <div style="font-size:0.72rem;color:var(--text-muted);text-transform:uppercase;letter-spacing:.04em;margin-bottom:2px">${label}</div>
        <div style="font-size:1rem;font-weight:600${cls ? `;color:var(--${cls})` : ''}">${value}</div>
      </div>`;
    }

    function renderInstance(inst) {
      const sc   = STATUS_COLOR[inst.status] || 'muted';
      const dot  = STATUS_DOT[inst.status]   || '○';
      const errRate = inst.totalRequests > 0
        ? ((inst.errorCount / inst.totalRequests) * 100).toFixed(1) + '%'
        : '—';
      const errCls  = inst.errorCount > 0 ? 'danger' : '';
      const urlShort = inst.url.replace(/^https?:\/\//, '');

      return `<div class="card" style="padding:14px 16px;border-left:3px solid var(--${sc})">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px">
          <code style="font-size:0.78rem;color:var(--text-muted)">${esc(urlShort)}</code>
          <span class="text-${sc}" style="font-size:0.82rem;font-weight:600">
            ${dot} ${inst.status}
          </span>
        </div>
        <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin-bottom:10px">
          ${workerKpi('HC latency',  fmtMs(inst.healthCheckMs))}
          ${workerKpi('Avg resp',    fmtMs(inst.avgResponseMs))}
          ${workerKpi('p95 resp',    fmtMs(inst.p95ResponseMs))}
          ${workerKpi('Last resp',   fmtMs(inst.lastResponseMs))}
          ${workerKpi('Error rate',  errRate, errCls)}
        </div>
        <div style="display:flex;justify-content:space-between;font-size:0.75rem;color:var(--text-muted)">
          <span>Requests: <strong>${inst.totalRequests.toLocaleString()}</strong> &nbsp; Errors: <strong style="color:var(--${errCls||'text-muted'})">${inst.errorCount.toLocaleString()}</strong></span>
          ${inst.lastChecked ? `<span>Checked ${fmtDateTime(inst.lastChecked)}</span>` : ''}
        </div>
      </div>`;
    }

    function renderService(svc) {
      const sc  = STATUS_COLOR[svc.status] || 'muted';
      const dot = STATUS_DOT[svc.status]   || '○';

      // aggregate totals across instances
      const totalReqs  = svc.instances.reduce((s, i) => s + i.totalRequests, 0);
      const totalErrs  = svc.instances.reduce((s, i) => s + i.errorCount, 0);
      const avgMs = (() => {
        const vals = svc.instances.map(i => i.avgResponseMs).filter(v => v != null);
        return vals.length ? Math.round(vals.reduce((a, b) => a + b, 0) / vals.length) : null;
      })();
      const p95Ms = (() => {
        const vals = svc.instances.map(i => i.p95ResponseMs).filter(v => v != null);
        return vals.length ? Math.round(Math.max(...vals)) : null;
      })();

      return `<div class="section" style="margin-bottom:12px">
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:10px">
          <span style="font-size:1rem;font-weight:600">${esc(svc.name)}</span>
          <span class="text-${sc}" style="font-size:0.82rem;font-weight:600">${dot} ${svc.status}</span>
          <span class="text-muted" style="font-size:0.78rem;margin-left:auto">
            ${svc.instances.length} instance${svc.instances.length !== 1 ? 's' : ''} &nbsp;·&nbsp;
            ${totalReqs.toLocaleString()} req &nbsp;·&nbsp;
            avg ${fmtMs(avgMs)} &nbsp;·&nbsp; p95 ${fmtMs(p95Ms)}
            ${totalErrs > 0 ? `&nbsp;·&nbsp; <span style="color:var(--danger)">${totalErrs.toLocaleString()} errors</span>` : ''}
          </span>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:10px">
          ${svc.instances.length
            ? svc.instances.map(renderInstance).join('')
            : `<div class="text-muted" style="padding:12px">No instances configured.</div>`}
        </div>
      </div>`;
    }

    async function loadWorkers() {
      const res = await web('GET', '/admin/workers');
      const container = document.getElementById('workers-container');
      if (!res?.ok) {
        container.innerHTML = '<div class="text-danger" style="padding:12px">Failed to load worker status.</div>';
        return;
      }
      container.innerHTML = res.data.map(renderService).join('');
      document.getElementById('workers-last-refresh').textContent =
        'Updated ' + new Date().toLocaleTimeString();
    }

    // ── Users ──────────────────────────────────────────────────────────────────

    window.loadUsers = async function () {
      const tbody = document.getElementById('users-tbody');
      tbody.innerHTML = empty(8, 'Loading…');
      closeKeysDrawer();

      const res = await web('GET', '/admin/users');
      if (!res?.ok) { tbody.innerHTML = err(8, 'Failed to load users.'); return; }
      const data = res.data;
      if (!data.length) { tbody.innerHTML = empty(8, 'No users found.'); return; }

      tbody.innerHTML = data.map(u => `
        <tr id="user-row-${u.id}">
          <td class="text-muted">#${u.id}</td>
          <td style="font-weight:500">${esc(u.name) || '<span class="text-muted">(no name)</span>'}</td>
          <td>${roleBadge(u.role)}</td>
          <td>${u.totalContributions.toLocaleString()}</td>
          <td>
            <button class="btn btn-secondary btn-sm" onclick="showKeys(${u.id}, '${esc(u.name || u.id)}')">
              ${u.keyCount} key${u.keyCount !== 1 ? 's' : ''}
            </button>
          </td>
          <td class="text-muted">${fmtDate(u.createdAt)}</td>
          <td>${u.isActive
            ? '<span class="badge badge-active">Active</span>'
            : '<span class="badge badge-inactive">Inactive</span>'}</td>
          <td>
            <div style="display:flex;gap:6px;flex-wrap:wrap;align-items:center">
              <select class="form-control" style="width:auto;padding:3px 8px;font-size:0.8rem" id="role-sel-${u.id}">
                <option value="User"        ${u.role === 'User'        ? 'selected' : ''}>User</option>
                <option value="Contributor" ${u.role === 'Contributor' ? 'selected' : ''}>Contributor</option>
                <option value="Admin"       ${u.role === 'Admin'       ? 'selected' : ''}>Admin</option>
              </select>
              <button class="btn btn-secondary btn-sm" onclick="setRole(${u.id})">Set</button>
              ${u.isActive
                ? `<button class="btn btn-danger btn-sm" onclick="deactivateUser(${u.id})">Deactivate</button>`
                : `<button class="btn btn-success btn-sm" onclick="activateUser(${u.id})">Activate</button>`}
            </div>
          </td>
        </tr>
      `).join('');
    };

    window.setRole = async function (id) {
      const role = document.getElementById(`role-sel-${id}`).value;
      const res  = await web('PUT', `/admin/users/${id}/role`, { role });
      if (!res?.ok) { alert(res?.data?.error || 'Failed to set role.'); return; }
      loadUsers();
    };

    window.deactivateUser = async function (id) {
      if (!confirm('Deactivate this account? They will not be able to log in.')) return;
      const res = await web('DELETE', `/admin/users/${id}`);
      if (!res?.ok) { alert(res?.data?.error || 'Failed.'); return; }
      loadUsers();
    };

    window.activateUser = async function (id) {
      const res = await web('POST', `/admin/users/${id}/activate`);
      if (res?.ok) loadUsers();
    };

    // ── Keys drawer ────────────────────────────────────────────────────────────

    window.showKeys = async function (userId, name) {
      const drawer = document.getElementById('keys-drawer');
      const tbody  = document.getElementById('keys-tbody');
      document.getElementById('keys-drawer-title').textContent = `API Keys — ${name}`;
      tbody.innerHTML = empty(6, 'Loading…');
      drawer.classList.remove('hidden');
      drawer.scrollIntoView({ behavior: 'smooth', block: 'start' });

      const res = await web('GET', `/admin/users/${userId}/keys`);
      if (!res?.ok) { tbody.innerHTML = err(6, 'Failed.'); return; }
      const data = res.data;
      if (!data.length) { tbody.innerHTML = empty(6, 'No keys.'); return; }

      tbody.innerHTML = data.map(k => `
        <tr>
          <td class="text-muted">#${k.id}</td>
          <td>${esc(k.label) || '—'}</td>
          <td class="text-muted">${fmtDate(k.createdAt)}</td>
          <td class="text-muted">${fmtDateTime(k.lastUsedAt)}</td>
          <td>${k.isActive
            ? '<span class="badge badge-active">Active</span>'
            : '<span class="badge badge-inactive">Revoked</span>'}</td>
          <td>${k.isActive
            ? `<button class="btn btn-danger btn-sm" onclick="revokeKey(${k.id},${userId},'${esc(name)}')">Revoke</button>`
            : '—'}</td>
        </tr>
      `).join('');
    };

    window.closeKeysDrawer = function () {
      document.getElementById('keys-drawer').classList.add('hidden');
    };

    window.revokeKey = async function (keyId, userId, name) {
      if (!confirm('Revoke this API key?')) return;
      const res = await web('DELETE', `/admin/keys/${keyId}`);
      if (res?.ok) showKeys(userId, name);
    };

    // ── Blocked IPs ────────────────────────────────────────────────────────────

    window.loadBlocked = async function () {
      const tbody = document.getElementById('blocked-tbody');
      tbody.innerHTML = empty(7, 'Loading…');

      const res = await web('GET', '/admin/blocked-ips');
      if (!res?.ok) { tbody.innerHTML = err(7, 'Failed to load.'); return; }
      const data = res.data;
      if (!data.length) { tbody.innerHTML = empty(7, 'No blocked IPs.'); return; }

      tbody.innerHTML = data.map(b => `
        <tr>
          <td class="text-muted">#${b.id}</td>
          <td><code style="font-size:0.75rem;color:var(--text-muted)">${b.ipHash.substring(0,16)}…</code></td>
          <td>${esc(b.reason)}</td>
          <td>${b.isManual
            ? '<span class="badge badge-admin">Manual</span>'
            : '<span class="badge badge-user">Auto</span>'}</td>
          <td class="text-muted">${fmtDateTime(b.blockedAt)}</td>
          <td class="text-muted">${b.expiresAt ? fmtDateTime(b.expiresAt) : 'Permanent'}</td>
          <td><button class="btn btn-secondary btn-sm" onclick="unblock(${b.id})">Unblock</button></td>
        </tr>
      `).join('');
    };

    window.blockIp = async function () {
      const ip      = document.getElementById('block-ip').value.trim();
      const reason  = document.getElementById('block-reason').value.trim();
      const expires = document.getElementById('block-expires').value;
      const alertEl = document.getElementById('block-alert');
      if (!ip || !reason) { showAlert(alertEl, 'IP and reason are required.'); return; }
      alertEl.classList.add('hidden');

      const res = await web('POST', '/admin/block-ip', {
        ip, reason, expiresAt: expires ? new Date(expires).toISOString() : null
      });
      if (!res?.ok) { showAlert(alertEl, res?.data?.error || 'Failed to block IP.'); return; }

      document.getElementById('block-ip').value = '';
      document.getElementById('block-reason').value = '';
      document.getElementById('block-expires').value = '';
      loadBlocked();
    };

    window.unblock = async function (id) {
      const res = await web('DELETE', `/admin/blocked-ips/${id}`);
      if (res?.ok) loadBlocked();
    };

    // ── Danger Zone ────────────────────────────────────────────────────────────

    window.purgeData = async function () {
      const alertEl = document.getElementById('purge-alert');
      alertEl.classList.add('hidden');
      if (!confirm('This will permanently delete ALL speed observations, aggregates, and summaries, and reset all contribution counters.\n\nType OK to confirm.')) return;
      if (prompt('Type PURGE to confirm:') !== 'PURGE') { showAlert(alertEl, 'Purge cancelled.', 'info'); return; }

      const res = await web('DELETE', '/admin/data');
      if (!res?.ok) { showAlert(alertEl, res?.data?.error || 'Purge failed.'); return; }
      showAlert(alertEl, res.data.message || 'Data purged.', 'success');
      loadStats();
    };

    // ── Helpers ────────────────────────────────────────────────────────────────

    function err(cols, msg) {
      return `<tr><td colspan="${cols}" class="text-danger" style="text-align:center;padding:16px">${msg}</td></tr>`;
    }
    function empty(cols, msg) {
      return `<tr><td colspan="${cols}" class="text-muted" style="text-align:center;padding:24px">${msg}</td></tr>`;
    }

    await seedHistory();
    Promise.all([loadStats(), loadWorkers(), loadUsers(), loadBlocked()]);
    setInterval(loadStats,   15_000);
    setInterval(loadWorkers, 10_000);
  </script>
}