@{
    Layout = "_MapLayout";
    ViewData["Title"] = "Routing";
}

@section Head {
    <link rel="stylesheet" href="https://unpkg.com/maplibre-gl@4/dist/maplibre-gl.css">
    <style>
        #map {
            position: absolute;
            top: 56px;
            left: 0;
            right: 0;
            bottom: 0;
        }

        /* ── Side panel ──────────────────────────────────────────── */
        #route-panel {
            position: absolute;
            top: 68px;
            left: 12px;
            width: 320px;
            max-height: calc(100vh - 80px);
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            display: flex;
            flex-direction: column;
            z-index: 10;
            overflow: hidden;
            box-shadow: 0 4px 24px rgba(0,0,0,0.5);
        }

        #panel-header {
            padding: 14px 16px 10px;
            border-bottom: 1px solid var(--border);
            flex-shrink: 0;
        }
        #panel-header h4 {
            font-size: 0.88rem;
            font-weight: 600;
            color: var(--text);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 12px;
        }

        .waypoint-row {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 8px;
        }
        .waypoint-icon {
            width: 22px;
            height: 22px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.7rem;
            font-weight: 700;
            flex-shrink: 0;
            color: #fff;
        }
        .waypoint-icon.origin { background: var(--success); }
        .waypoint-icon.destination { background: var(--danger); }

        .waypoint-input-wrap {
            flex: 1;
            position: relative;
        }
        .waypoint-input {
            width: 100%;
            background: var(--surface2);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            color: var(--text);
            font-size: 0.82rem;
            padding: 7px 10px;
            outline: none;
            box-sizing: border-box;
        }
        .waypoint-input:focus {
            border-color: var(--accent);
        }

        .waypoint-pick-btn {
            background: none;
            border: 1px solid var(--border);
            border-radius: var(--radius);
            color: var(--text-muted);
            cursor: pointer;
            padding: 5px 7px;
            flex-shrink: 0;
            font-size: 0.75rem;
            transition: border-color 0.15s, color 0.15s;
        }
        .waypoint-pick-btn:hover,
        .waypoint-pick-btn.active {
            border-color: var(--accent);
            color: var(--accent);
        }

        .autocomplete-list {
            position: absolute;
            top: calc(100% + 4px);
            left: 0;
            right: 0;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            z-index: 100;
            max-height: 180px;
            overflow-y: auto;
            box-shadow: 0 4px 16px rgba(0,0,0,0.4);
        }
        .autocomplete-item {
            padding: 8px 10px;
            font-size: 0.8rem;
            color: var(--text);
            cursor: pointer;
            border-bottom: 1px solid var(--border);
        }
        .autocomplete-item:last-child { border-bottom: none; }
        .autocomplete-item:hover { background: var(--surface2); }

        .swap-btn {
            background: none;
            border: 1px solid var(--border);
            border-radius: var(--radius);
            color: var(--text-muted);
            cursor: pointer;
            padding: 4px 8px;
            font-size: 0.75rem;
            transition: border-color 0.15s, color 0.15s;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: -4px auto 4px;
        }
        .swap-btn:hover {
            border-color: var(--accent);
            color: var(--accent);
        }

        .toggle-row {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-top: 8px;
            margin-bottom: 4px;
            cursor: pointer;
        }
        .toggle-row span {
            font-size: 0.78rem;
            color: var(--text-muted);
            user-select: none;
        }
        .toggle-switch {
            position: relative;
            width: 34px;
            height: 18px;
            flex-shrink: 0;
        }
        .toggle-switch input {
            position: absolute;
            opacity: 0;
            width: 100%;
            height: 100%;
            margin: 0;
            cursor: pointer;
            z-index: 1;
        }
        .toggle-slider {
            position: absolute;
            cursor: pointer;
            top: 0; left: 0; right: 0; bottom: 0;
            background: var(--border);
            border-radius: 9px;
            transition: background 0.2s;
        }
        .toggle-slider::before {
            content: '';
            position: absolute;
            width: 14px;
            height: 14px;
            left: 2px;
            bottom: 2px;
            background: var(--text);
            border-radius: 50%;
            transition: transform 0.2s;
        }
        .toggle-switch input:checked + .toggle-slider {
            background: var(--accent);
        }
        .toggle-switch input:checked + .toggle-slider::before {
            transform: translateX(16px);
        }

        /* ── Depart-at controls ────────────────────────────────── */
        .depart-row {
            display: flex;
            align-items: center;
            gap: 6px;
            margin-top: 8px;
        }
        .depart-row label {
            font-size: 0.78rem;
            color: var(--text-muted);
            white-space: nowrap;
        }
        .depart-select {
            flex: 1;
            background: var(--surface2);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            color: var(--text);
            font-size: 0.78rem;
            padding: 5px 6px;
            outline: none;
        }
        .depart-select:focus { border-color: var(--accent); }

        /* ── Travel-time bar chart ────────────────────────────── */
        .time-chart {
            margin-top: 10px;
            padding-top: 8px;
            border-top: 1px solid var(--border);
        }
        .time-chart-label {
            font-size: 0.72rem;
            font-weight: 600;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 6px;
        }
        .time-chart-area {
            display: flex;
            gap: 0;
        }
        .time-chart-yaxis {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            align-items: flex-end;
            padding-right: 4px;
            height: 64px;
            flex-shrink: 0;
        }
        .time-chart-ytick {
            font-size: 0.58rem;
            color: var(--text-muted);
            line-height: 1;
        }
        .time-chart-body {
            flex: 1;
            min-width: 0;
            display: flex;
            flex-direction: column;
        }
        .time-chart-bars {
            display: flex;
            align-items: flex-end;
            gap: 1px;
            height: 64px;
            border-left: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
        }
        .time-bar-wrap {
            flex: 1;
            min-width: 0;
            height: 100%;
            display: flex;
            align-items: flex-end;
            cursor: pointer;
            position: relative;
        }
        .time-bar {
            width: 100%;
            border-radius: 2px 2px 0 0;
            min-height: 2px;
            transition: background 0.15s;
        }
        .time-bar.faded { background: rgba(88,166,255,0.25); }
        .time-bar.active { background: var(--accent); }
        .time-bar-range {
            position: absolute;
            width: 2px;
            background: var(--text-muted);
            opacity: 0.45;
            left: 50%;
            transform: translateX(-50%);
        }
        .time-bar-range-cap {
            position: absolute;
            width: 6px;
            height: 1px;
            background: var(--text-muted);
            opacity: 0.45;
            left: 50%;
            transform: translateX(-50%);
        }
        .time-chart-xaxis {
            display: flex;
            gap: 1px;
            padding-left: 0;
        }
        .time-chart-xtick {
            flex: 1;
            min-width: 0;
            font-size: 0.56rem;
            color: var(--text-muted);
            text-align: center;
            padding-top: 2px;
            overflow: hidden;
        }
        .time-chart-loading {
            font-size: 0.75rem;
            color: var(--text-muted);
            text-align: center;
            padding: 8px 0;
        }

        #route-btn {
            width: 100%;
            margin-top: 8px;
            padding: 8px;
            font-size: 0.82rem;
        }

        /* ── Results ─────────────────────────────────────────────── */
        #panel-results {
            flex: 1;
            overflow-y: auto;
            padding: 12px 16px;
        }

        .route-card {
            background: var(--surface2);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 10px 12px;
            margin-bottom: 8px;
            cursor: pointer;
            transition: border-color 0.15s;
        }
        .route-card:hover { border-color: var(--accent); }
        .route-card.selected { border-color: var(--accent); background: rgba(88,166,255,0.07); }

        .route-card-header {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            margin-bottom: 4px;
        }
        .route-title {
            font-weight: 600;
            font-size: 0.84rem;
            color: var(--text);
        }
        .route-time {
            font-size: 0.9rem;
            font-weight: 700;
            color: var(--accent);
        }

        .route-meta {
            font-size: 0.75rem;
            color: var(--text-muted);
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .delay-badge {
            display: inline-block;
            border-radius: 4px;
            padding: 1px 6px;
            font-size: 0.7rem;
            font-weight: 600;
        }
        .delay-badge.none  { background: rgba(63,185,80,0.2);  color: var(--success); }
        .delay-badge.light { background: rgba(210,153,34,0.2); color: var(--warning); }
        .delay-badge.heavy { background: rgba(248,81,73,0.2);  color: var(--danger); }

        .eco-row {
            display: flex;
            align-items: center;
            gap: 6px;
            margin-top: 6px;
            font-size: 0.75rem;
        }
        .eco-badge {
            display: inline-block;
            border-radius: 4px;
            padding: 1px 6px;
            font-size: 0.7rem;
            font-weight: 600;
            background: rgba(63,185,80,0.15);
            color: var(--success);
        }
        .eco-badge.worst {
            background: rgba(248,81,73,0.15);
            color: var(--danger);
        }
        .eco-detail {
            color: var(--text-muted);
        }

        .jams-section {
            margin-top: 8px;
            padding-top: 8px;
            border-top: 1px solid var(--border);
        }
        .jams-label {
            font-size: 0.72rem;
            font-weight: 600;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 4px;
        }
        .jam-row {
            font-size: 0.75rem;
            color: var(--danger);
            margin-bottom: 2px;
        }

        .panel-empty {
            color: var(--text-muted);
            font-size: 0.8rem;
            text-align: center;
            padding: 24px 0;
        }

        #panel-error {
            padding: 8px 12px;
            background: rgba(248,81,73,0.12);
            border-top: 1px solid var(--border);
            color: var(--danger);
            font-size: 0.8rem;
            flex-shrink: 0;
            display: none;
        }

        /* ── Pick cursor instructions ────────────────────────────── */
        #pick-hint {
            position: absolute;
            bottom: 24px;
            left: 50%;
            transform: translateX(-50%);
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 8px 14px;
            font-size: 0.8rem;
            color: var(--text);
            z-index: 20;
            display: none;
            pointer-events: none;
            box-shadow: 0 2px 8px rgba(0,0,0,0.4);
        }

        /* ── Mobile layout ─────────────────────────────────────── */
        @@media (max-width: 640px) {
            #route-panel {
                position: fixed;
                top: auto;
                left: 0;
                right: 0;
                bottom: 0;
                width: 100%;
                max-height: 55vh;
                border-radius: var(--radius-lg) var(--radius-lg) 0 0;
                box-shadow: 0 -4px 24px rgba(0,0,0,0.5);
            }
            #map {
                bottom: 0;
            }
            #panel-header {
                padding: 10px 12px 8px;
            }
            #panel-header h4 {
                font-size: 0.8rem;
                margin-bottom: 8px;
            }
            .waypoint-row { margin-bottom: 6px; }
            .waypoint-input { padding: 6px 8px; font-size: 0.78rem; }
            .depart-row { margin-top: 4px; }
            #panel-results { padding: 8px 12px; }
            .route-card { padding: 8px 10px; margin-bottom: 6px; }
            #pick-hint { bottom: 58vh; }

            /* Drag handle */
            #panel-header::before {
                content: '';
                display: block;
                width: 36px;
                height: 4px;
                background: var(--border);
                border-radius: 2px;
                margin: 0 auto 8px;
            }
        }

        /* ── Spinner ─────────────────────────────────────────────── */
        .spinner {
            display: inline-block;
            width: 14px; height: 14px;
            border: 2px solid var(--border);
            border-top-color: var(--accent);
            border-radius: 50%;
            animation: spin 0.7s linear infinite;
            vertical-align: middle;
        }
        @@keyframes spin { to { transform: rotate(360deg); } }
    </style>
}

<div id="map"></div>

<div id="route-panel">
    <div id="panel-header">
        <h4>Route</h4>

        <div class="waypoint-row">
            <div class="waypoint-icon origin">A</div>
            <div class="waypoint-input-wrap">
                <input id="origin-input" class="waypoint-input" type="text" placeholder="Origin…" autocomplete="off">
                <div id="origin-ac" class="autocomplete-list" style="display:none"></div>
            </div>
            <button class="waypoint-pick-btn" id="origin-pick-btn" title="Click on map to set origin">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><line x1="12" y1="2" x2="12" y2="5"/><line x1="12" y1="19" x2="12" y2="22"/><line x1="2" y1="12" x2="5" y2="12"/><line x1="19" y1="12" x2="22" y2="12"/></svg>
            </button>
        </div>

        <button class="swap-btn" id="swap-btn" title="Swap origin and destination">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="7 3 7 21"/><polyline points="3 7 7 3 11 7"/><polyline points="17 21 17 3"/><polyline points="13 17 17 21 21 17"/></svg>
        </button>

        <div class="waypoint-row">
            <div class="waypoint-icon destination">B</div>
            <div class="waypoint-input-wrap">
                <input id="dest-input" class="waypoint-input" type="text" placeholder="Destination…" autocomplete="off">
                <div id="dest-ac" class="autocomplete-list" style="display:none"></div>
            </div>
            <button class="waypoint-pick-btn" id="dest-pick-btn" title="Click on map to set destination">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><line x1="12" y1="2" x2="12" y2="5"/><line x1="12" y1="19" x2="12" y2="22"/><line x1="2" y1="12" x2="5" y2="12"/><line x1="19" y1="12" x2="22" y2="12"/></svg>
            </button>
        </div>

        <label class="toggle-row" for="traffic-toggle">
            <div class="toggle-switch">
                <input type="checkbox" id="traffic-toggle" checked>
                <span class="toggle-slider"></span>
            </div>
            <span>OpenTrafficDB traffic</span>
        </label>

        <div class="depart-row">
            <label>Depart:</label>
            <select id="depart-day" class="depart-select">
                <option value="">Now</option>
                <option value="1">Monday</option>
                <option value="2">Tuesday</option>
                <option value="3">Wednesday</option>
                <option value="4">Thursday</option>
                <option value="5">Friday</option>
                <option value="6">Saturday</option>
                <option value="0">Sunday</option>
            </select>
            <select id="depart-hour" class="depart-select" style="max-width:80px" disabled>
            </select>
        </div>

        <div class="depart-row">
            <label>Bucket</label>
            <select id="bucket-width" class="depart-select" style="max-width:80px">
                <option value="1">1 h</option>
                <option value="2">2 h</option>
                <option value="3" selected>3 h</option>
                <option value="4">4 h</option>
                <option value="6">6 h</option>
            </select>
        </div>
        <div id="time-chart-container"></div>

        <button id="route-btn" class="btn btn-primary" onclick="getRoute()">Get Route</button>
    </div>

    <div id="panel-results">
        <div class="panel-empty" id="empty-state">Enter origin and destination to get started.</div>
    </div>
    <div id="panel-error"></div>
</div>

<div id="pick-hint"></div>

@section Scripts {
<script src="https://unpkg.com/maplibre-gl@4/dist/maplibre-gl.js"></script>
<script>
(function () {
    'use strict';

    const STYLE_URL = 'https://api.maptiler.com/maps/streets-v2-dark/style.json?key=YOUR_MAPTILER_API_KEY';
    const NOMINATIM = 'https://nominatim.openstreetmap.org/search';

    // ── State ──────────────────────────────────────────────────────
    let map;
    let originLngLat    = null;  // [lng, lat]
    let destLngLat      = null;
    let pickMode        = null;  // 'origin' | 'dest' | null
    let routes          = [];    // parsed trip objects from response
    let selectedIdx     = 0;
    let acTimers        = {};
    let markers         = { origin: null, dest: null };
    let chartData       = null;  // array of { hour, mins } for 3h slots

    // ── Populate hour dropdown ──────────────────────────────────
    (function initDepartControls() {
        const hourSel = document.getElementById('depart-hour');
        for (var h = 0; h < 24; h++) {
            var opt = document.createElement('option');
            opt.value = h;
            opt.textContent = String(h).padStart(2, '0') + ':00';
            hourSel.appendChild(opt);
        }
        // Set default to current hour
        hourSel.value = new Date().getHours();

        document.getElementById('depart-day').addEventListener('change', function () {
            hourSel.disabled = !this.value;
            if (typeof fetchTimeChart === 'function') fetchTimeChart();
        });
        document.getElementById('bucket-width').addEventListener('change', function () {
            if (typeof fetchTimeChart === 'function') fetchTimeChart();
        });
    })();

    // ── Map init ───────────────────────────────────────────────────
    map = new maplibregl.Map({
        container: 'map',
        style:     STYLE_URL,
        center:    [6.953101,50.935173],  // centre on Cologne by default
        zoom:      9,
        attributionControl: { compact: true }
    });

    map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');
    map.addControl(new maplibregl.GeolocateControl({
        positionOptions: { enableHighAccuracy: true },
        trackUserLocation: false
    }), 'top-right');

    map.on('load', function () {
        // Traffic tile overlay (same source as /map/traffic)
        map.addSource('traffic', {
            type: 'vector',
            tiles: [window.location.origin + '/tiles/traffic/current/{z}/{x}/{y}'],
            minzoom: 6, maxzoom: 16
        });

        map.addLayer({
            id:     'traffic-lines',
            type:   'line',
            source: 'traffic',
            'source-layer': 'traffic',
            layout: {
                'line-cap':  'round',
                'line-join': 'round'
            },
            paint: {
                // Width scales with zoom
                'line-width': [
                    'interpolate', ['linear'], ['zoom'],
                    8,  2,
                    12, 4,
                    16, 7
                ],
                // Colour by jam_estimate when available, grey otherwise
                'line-color': [
                    'case',
                    ['has', 'jam_estimate'],
                    [
                        'interpolate', ['linear'],
                        ['get', 'jam_estimate'],
                        0.0,  '#3fb950',   // free flow — green
                        0.35, '#d29922',   // slowing   — yellow
                        0.70, '#f85149'    // congested — red
                    ],
                    '#8b949e'  // no speed-limit data — muted grey
                ],
                'line-opacity': 0.85
            }
        });

        // Route line sources
        map.addSource('route-inactive', { type: 'geojson', data: emptyFC() });
        map.addSource('route-active',   { type: 'geojson', data: emptyFC() });
        map.addSource('jams',           { type: 'geojson', data: emptyFC() });

        map.addLayer({
            id: 'route-inactive-line',
            type: 'line',
            source: 'route-inactive',
            layout: { 'line-cap': 'round', 'line-join': 'round' },
            paint: {
                'line-color': '#8b949e',
                'line-width': 5,
                'line-opacity': 0.6
            }
        });

        map.addLayer({
            id: 'route-active-line',
            type: 'line',
            source: 'route-active',
            layout: { 'line-cap': 'round', 'line-join': 'round' },
            paint: {
                'line-color': ['get', 'color'],
                'line-width': 6,
                'line-opacity': 0.95
            }
        });

        map.addLayer({
            id: 'jams-line',
            type: 'line',
            source: 'jams',
            layout: { 'line-cap': 'round', 'line-join': 'round' },
            paint: {
                'line-color': ['match', ['get', 'severity'], 'heavy', '#f85149', '#d29922'],
                'line-width': 8,
                'line-opacity': 0.9
            }
        });
    });

    // ── Click-to-pick ──────────────────────────────────────────────
    map.on('click', function (e) {
        if (!pickMode) return;
        const ll = [e.lngLat.lng, e.lngLat.lat];
        if (pickMode === 'origin') {
            setOrigin(ll, fmtCoord(ll));
        } else {
            setDest(ll, fmtCoord(ll));
        }
        setPickMode(null);
    });

    // ── Waypoint markers ───────────────────────────────────────────
    function makeMarker(color) {
        const el = document.createElement('div');
        el.style.cssText = `width:14px;height:14px;border-radius:50%;background:${color};
            border:3px solid #fff;box-shadow:0 2px 6px rgba(0,0,0,0.5);cursor:pointer;`;
        return el;
    }

    function setOrigin(ll, label) {
        originLngLat = ll;
        document.getElementById('origin-input').value = label;
        if (markers.origin) markers.origin.remove();
        markers.origin = new maplibregl.Marker({ element: makeMarker('var(--success)') })
            .setLngLat(ll).addTo(map);
    }

    function setDest(ll, label) {
        destLngLat = ll;
        document.getElementById('dest-input').value = label;
        if (markers.dest) markers.dest.remove();
        markers.dest = new maplibregl.Marker({ element: makeMarker('var(--danger)') })
            .setLngLat(ll).addTo(map);
    }

    function fmtCoord(ll) {
        return ll[1].toFixed(5) + ', ' + ll[0].toFixed(5);
    }

    // ── Pick-mode toggle ───────────────────────────────────────────
    function setPickMode(mode) {
        pickMode = mode;
        map.getCanvas().style.cursor = mode ? 'crosshair' : '';
        const hint = document.getElementById('pick-hint');
        if (mode) {
            hint.textContent = 'Click on the map to set the ' + (mode === 'origin' ? 'origin' : 'destination');
            hint.style.display = 'block';
        } else {
            hint.style.display = 'none';
        }
        document.getElementById('origin-pick-btn').classList.toggle('active', mode === 'origin');
        document.getElementById('dest-pick-btn').classList.toggle('active', mode === 'dest');
    }

    document.getElementById('origin-pick-btn').addEventListener('click', function () {
        setPickMode(pickMode === 'origin' ? null : 'origin');
    });
    document.getElementById('dest-pick-btn').addEventListener('click', function () {
        setPickMode(pickMode === 'dest' ? null : 'dest');
    });

    // ── Swap origin ↔ destination ────────────────────────────────
    document.getElementById('swap-btn').addEventListener('click', function () {
        var tmpLngLat = originLngLat;
        var tmpLabel  = document.getElementById('origin-input').value;
        if (destLngLat) {
            setOrigin(destLngLat, document.getElementById('dest-input').value);
        } else {
            originLngLat = null;
            document.getElementById('origin-input').value = '';
            if (markers.origin) { markers.origin.remove(); markers.origin = null; }
        }
        if (tmpLngLat) {
            setDest(tmpLngLat, tmpLabel);
        } else {
            destLngLat = null;
            document.getElementById('dest-input').value = '';
            if (markers.dest) { markers.dest.remove(); markers.dest = null; }
        }
    });

    // ── Geocode autocomplete ───────────────────────────────────────
    function setupAutocomplete(inputId, listId, onSelect) {
        const input = document.getElementById(inputId);
        const list  = document.getElementById(listId);

        input.addEventListener('input', function () {
            clearTimeout(acTimers[inputId]);
            const q = input.value.trim();
            if (q.length < 3) { list.style.display = 'none'; return; }
            acTimers[inputId] = setTimeout(() => geocode(q, list, onSelect, input), 350);
        });

        input.addEventListener('blur', function () {
            setTimeout(() => { list.style.display = 'none'; }, 200);
        });
    }

    async function geocode(q, list, onSelect, input) {
        try {
            const url = NOMINATIM + '?q=' + encodeURIComponent(q) + '&format=json&limit=5';
            const res = await fetch(url, { headers: { 'Accept-Language': 'en' } });
            const data = await res.json();
            list.innerHTML = '';
            if (!data.length) { list.style.display = 'none'; return; }
            data.forEach(function (item) {
                const el = document.createElement('div');
                el.className = 'autocomplete-item';
                el.textContent = item.display_name;
                el.addEventListener('mousedown', function () {
                    onSelect([parseFloat(item.lon), parseFloat(item.lat)], item.display_name);
                    list.style.display = 'none';
                });
                list.appendChild(el);
            });
            list.style.display = 'block';
        } catch (_) {
            list.style.display = 'none';
        }
    }

    setupAutocomplete('origin-input', 'origin-ac', function (ll, label) {
        setOrigin(ll, label);
        map.flyTo({ center: ll, zoom: Math.max(map.getZoom(), 12) });
    });

    setupAutocomplete('dest-input', 'dest-ac', function (ll, label) {
        setDest(ll, label);
        map.flyTo({ center: ll, zoom: Math.max(map.getZoom(), 12) });
    });

    // ── Build Valhalla request body ─────────────────────────────────
    function buildRouteBody(overrideDay, overrideHour) {
        var body = {
            locations: [
                { lon: originLngLat[0], lat: originLngLat[1], type: 'break' },
                { lon: destLngLat[0],   lat: destLngLat[1],   type: 'break' }
            ],
            costing: 'auto',
            costing_options: { auto: {
                top_speed: 120, fixed_speed: 0,
                maneuver_penalty: 11,
                country_crossing_penalty: 0, country_crossing_cost: 600,
                use_highways: 0.4, use_tolls: 1, use_ferry: 1, ferry_cost: 300,
                use_living_streets: 0.8, use_tracks: 0,
                private_access_penalty: 450, destination_only_penalty: 300,
                service_penalty: 15, service_factor: 1,
                gate_penalty: 300, gate_cost: 30,
                toll_booth_penalty: 0, toll_booth_cost: 15,
                closure_factor: 9, ignore_closures: false,
                ignore_restrictions: false, ignore_access: false,
                exclude_unpaved: false, exclude_cash_only_tolls: false,
                shortest: false, disable_hierarchy_pruning: false,
                include_hov2: false, include_hov3: false, include_hot: false,
                width: 1.6, height: 1.9
            }},
            alternates: 2,
            units: 'kilometers',
            shortcuts: false
        };

        // Use override or UI selection for depart time
        var day  = overrideDay  != null ? overrideDay  : document.getElementById('depart-day').value;
        var hour = overrideHour != null ? overrideHour : parseInt(document.getElementById('depart-hour').value);
        if (day !== '' && day !== null) {
            var dt = getNextWeekday(parseInt(day), hour);
            body.date_time = { type: 1, value: dt };
        }
        return body;
    }

    // Get next occurrence of a weekday (0=Sun..6=Sat) at given hour
    function getNextWeekday(dow, hour) {
        var d = new Date();
        var diff = (dow - d.getDay() + 7) % 7;
        if (diff === 0 && d.getHours() > hour) diff = 7;
        d.setDate(d.getDate() + diff);
        d.setHours(hour, 0, 0, 0);
        // Valhalla format: YYYY-MM-DDTHH:MM
        return d.getFullYear() + '-' +
            String(d.getMonth() + 1).padStart(2, '0') + '-' +
            String(d.getDate()).padStart(2, '0') + 'T' +
            String(hour).padStart(2, '0') + ':00';
    }

    // ── Routing ────────────────────────────────────────────────────
    window.getRoute = async function () {
        if (!originLngLat || !destLngLat) {
            showError('Please set both origin and destination.');
            return;
        }
        clearError();
        setLoading(true);

        const useTraffic = document.getElementById('traffic-toggle').checked;

        const body = buildRouteBody();

        try {
            const url = '/web/route' + (useTraffic ? '' : '?raw=true');
            const res = await fetch(url, {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            });

            if (res.status === 401) {
                showError('You must be signed in to use routing. <a href="/Home/Login" style="color:var(--accent)">Sign in</a>');
                setLoading(false);
                return;
            }

            const data = await res.json();

            if (!res.ok) {
                showError(data.error || 'Routing failed.');
                setLoading(false);
                return;
            }

            // Support both { trip } (single) and { alternates } (multi)
            routes = extractTrips(data);
            selectedIdx = 0;
            renderResults();
            renderMap(0);

            // Fetch predicted travel times for bar chart (fire-and-forget)
            if (useTraffic) fetchTimeChart();

        } catch (err) {
            showError('Network error: ' + err.message);
        }

        setLoading(false);
    };

    // Press Enter in inputs to trigger routing
    ['origin-input', 'dest-input'].forEach(function (id) {
        document.getElementById(id).addEventListener('keydown', function (e) {
            if (e.key === 'Enter') window.getRoute();
        });
    });

    // ── Extract trips array from Valhalla response ─────────────────
    function extractTrips(data) {
        const out = [];
        if (data.trip) out.push(data.trip);
        if (data.alternates) data.alternates.forEach(a => a.trip && out.push(a.trip));
        return out;
    }

    // ── Decode precision-6 polyline ────────────────────────────────
    function decodePolyline6(str) {
        let index = 0, lat = 0, lng = 0;
        const coords = [];
        while (index < str.length) {
            let b, shift = 0, result = 0;
            do { b = str.charCodeAt(index++) - 63; result |= (b & 0x1f) << shift; shift += 5; } while (b >= 0x20);
            lat += (result & 1) ? ~(result >> 1) : result >> 1;
            shift = 0; result = 0;
            do { b = str.charCodeAt(index++) - 63; result |= (b & 0x1f) << shift; shift += 5; } while (b >= 0x20);
            lng += (result & 1) ? ~(result >> 1) : result >> 1;
            coords.push([lng / 1e6, lat / 1e6]);
        }
        return coords;
    }

    // ── Render results panel ───────────────────────────────────────
    function renderResults() {
        const panel = document.getElementById('panel-results');
        panel.innerHTML = '';

        const hasTraffic = document.getElementById('traffic-toggle').checked;

        // Find worst CO2 across all routes for relative comparison
        let worstCo2 = 0;
        if (hasTraffic) {
            routes.forEach(function (trip) {
                const co2 = (trip.trafficAnalysis || {}).co2GramsEstimate;
                if (co2 != null && co2 > worstCo2) worstCo2 = co2;
            });
        }

        routes.forEach(function (trip, i) {
            const ta   = trip.trafficAnalysis || {};
            const sum  = trip.summary || {};
            const mins = ta.liveDurationMinutes != null
                ? ta.liveDurationMinutes
                : (sum.time != null ? sum.time / 60 : null);
            const dist = sum.length != null ? sum.length.toFixed(1) + ' km' : '—';

            const card = document.createElement('div');
            card.className = 'route-card' + (i === selectedIdx ? ' selected' : '');
            card.dataset.idx = i;

            let metaHtml = `<span>${dist}</span>`;
            let ecoHtml  = '';
            let jamsHtml = '';

            if (hasTraffic) {
                const delay = ta.totalDelayMinutes;
                const delayPct = ta.delayPercent;
                let delayClass = 'none', delayTxt = 'No delay';
                if (delay != null && delay > 0.5) {
                    delayClass = delay < 3 ? 'light' : 'heavy';
                    delayTxt   = '+' + delay.toFixed(1) + ' min (' + (delayPct != null ? delayPct.toFixed(0) : '?') + '%)';
                }
                const coverage = ta.trafficCoverageRatio != null
                    ? Math.round(ta.trafficCoverageRatio * 100) + '% coverage'
                    : '';
                if (coverage) metaHtml += '<span>' + coverage + '</span>';
                metaHtml += `<span class="delay-badge ${delayClass}">${delayTxt}</span>`;

                // Eco / CO2 row
                const co2 = ta.co2GramsEstimate;
                if (co2 != null) {
                    const co2Kg = (co2 / 1000).toFixed(2);
                    let savingHtml = '';
                    if (worstCo2 > 0 && co2 < worstCo2) {
                        const pct = Math.round((1 - co2 / worstCo2) * 100);
                        if (pct > 0) savingHtml = `<span class="eco-badge">${pct}% less CO2</span>`;
                    } else if (worstCo2 > 0 && co2 >= worstCo2 && routes.length > 1) {
                        savingHtml = '<span class="eco-badge worst">Highest CO2</span>';
                    }
                    ecoHtml = `<div class="eco-row">`
                        + `<span class="eco-detail">${co2Kg} kg CO2</span>`
                        + savingHtml
                        + `</div>`;
                }

                if (ta.jams && ta.jams.length) {
                    const jamsList = ta.jams.slice(0, 3).map(j =>
                        `<div class="jam-row">⚠ ${j.delayMinutes.toFixed(1)} min – ${j.liveSpeedKmh.toFixed(0)} km/h (${j.lengthKm.toFixed(1)} km)</div>`
                    ).join('');
                    jamsHtml = `<div class="jams-section"><div class="jams-label">Traffic Jams</div>${jamsList}</div>`;
                }
            } else {
                metaHtml += '<span class="delay-badge none">Raw Valhalla</span>';
            }

            card.innerHTML = `
                <div class="route-card-header">
                    <span class="route-title">${i === 0 ? (hasTraffic ? 'Eco best' : 'Best route') : 'Alternative ' + i}</span>
                    <span class="route-time">${mins != null ? fmtMins(mins) : '—'}</span>
                </div>
                <div class="route-meta">
                    ${metaHtml}
                </div>
                ${ecoHtml}
                ${jamsHtml}
            `;

            card.addEventListener('click', function () {
                selectedIdx = i;
                renderResults();
                renderMap(i);
            });

            panel.appendChild(card);
        });
    }

    function fmtMins(m) {
        if (m < 60) return Math.round(m) + ' min';
        const h = Math.floor(m / 60), rem = Math.round(m % 60);
        return h + ' h ' + (rem ? rem + ' min' : '');
    }

    // ── Render route on map ────────────────────────────────────────
    function routeColor(i, selected) {
        if (i !== selected) return '#8b949e';
        return '#58a6ff';
    }

    function renderMap(activeIdx) {
        if (!routes.length) return;

        const inactiveFeatures = [];
        const activeFeature    = null;

        routes.forEach(function (trip, i) {
            const shape = trip.legs && trip.legs[0] && trip.legs[0].shape;
            if (!shape) return;
            const coords = decodePolyline6(shape);
            if (i !== activeIdx) {
                inactiveFeatures.push({
                    type: 'Feature',
                    geometry: { type: 'LineString', coordinates: coords }
                });
            }
        });

        // Active route
        const activeTrip = routes[activeIdx];
        const activeShape = activeTrip && activeTrip.legs && activeTrip.legs[0] && activeTrip.legs[0].shape;
        const activeCoords = activeShape ? decodePolyline6(activeShape) : [];
        const color = routeColor(activeIdx, activeIdx);

        map.getSource('route-inactive').setData({ type: 'FeatureCollection', features: inactiveFeatures });
        map.getSource('route-active').setData({
            type: 'FeatureCollection',
            features: activeCoords.length ? [{
                type: 'Feature',
                properties: { color },
                geometry: { type: 'LineString', coordinates: activeCoords }
            }] : []
        });

        // Jams
        const jamFeatures = [];
        if (activeTrip && activeTrip.trafficAnalysis && activeTrip.trafficAnalysis.jams) {
            activeTrip.trafficAnalysis.jams.forEach(function (jam) {
                if (!jam.encodedPolyline) return;
                const coords = decodePolyline6(jam.encodedPolyline);
                jamFeatures.push({
                    type: 'Feature',
                    properties: { severity: jam.delayMinutes >= 3 ? 'heavy' : 'light' },
                    geometry: { type: 'LineString', coordinates: coords }
                });
            });
        }
        map.getSource('jams').setData({ type: 'FeatureCollection', features: jamFeatures });

        // Fit bounds to active route
        if (activeCoords.length) {
            const bounds = activeCoords.reduce(function (b, c) {
                return b.extend(c);
            }, new maplibregl.LngLatBounds(activeCoords[0], activeCoords[0]));
            map.fitBounds(bounds, { padding: { top: 60, bottom: 60, left: 360, right: 60 }, maxZoom: 14 });
        }
    }

    // ── Helpers ────────────────────────────────────────────────────
    function emptyFC() {
        return { type: 'FeatureCollection', features: [] };
    }

    function showError(msg) {
        const el = document.getElementById('panel-error');
        el.innerHTML = msg;
        el.style.display = 'block';
    }
    function clearError() {
        const el = document.getElementById('panel-error');
        el.style.display = 'none';
        el.textContent = '';
    }
    function setLoading(on) {
        const btn = document.getElementById('route-btn');
        btn.disabled = on;
        btn.innerHTML = on ? '<span class="spinner"></span> Routing…' : 'Get Route';
    }

    // ── Predicted travel-time bar chart ────────────────────────────
    async function fetchTimeChart() {
        var container = document.getElementById('time-chart-container');
        container.innerHTML = '<div class="time-chart-loading"><span class="spinner"></span> Loading predictions…</div>';

        var daySel = document.getElementById('depart-day').value;
        var selectedHour = daySel !== '' ? parseInt(document.getElementById('depart-hour').value) : new Date().getHours();

        var bucketWidth = parseInt(document.getElementById('bucket-width').value) || 3;
        var dayVal = document.getElementById('depart-day').value;
        var body = {
            locations: [
                { lat: originLngLat[1], lon: originLngLat[0] },
                { lat: destLngLat[1],   lon: destLngLat[0] }
            ],
            bucketWidthHours: bucketWidth,
            dayOfWeek: dayVal !== '' ? parseInt(dayVal) : null
        };

        try {
            var resp = await fetch('/web/route/buckets', {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            });
            if (!resp.ok) { container.innerHTML = ''; return; }
            var data = await resp.json();

            chartData = (data.buckets || []).map(function (b) {
                var hour = parseInt(b.start.split(':')[0]);
                return { hour: hour, mins: b.travelTimeMinutes, minMins: b.minTravelTimeMinutes, maxMins: b.maxTravelTimeMinutes };
            });
            renderTimeChart(chartData, selectedHour);
        } catch (e) {
            container.innerHTML = '';
        }
    }

    function renderTimeChart(data, selectedHour) {
        var container = document.getElementById('time-chart-container');
        var validMins = data.filter(function (d) { return d.mins != null; }).map(function (d) { return d.mins; });
        if (!validMins.length) {
            container.innerHTML = '';
            return;
        }

        // Axis range: from global sub-bucket min to global sub-bucket max
        var allMin = data.reduce(function (m, d) { return d.minMins != null ? Math.min(m, d.minMins) : m; }, Infinity);
        var allMax = data.reduce(function (m, d) { return d.maxMins != null ? Math.max(m, d.maxMins) : m; }, 0);
        // Fall back to avg min/max if no sub-bucket data
        if (!isFinite(allMin)) allMin = Math.min.apply(null, validMins);
        if (allMax === 0) allMax = Math.max.apply(null, validMins);
        // Add 5% padding so bars don't touch the edges
        var pad = (allMax - allMin) * 0.05 || 1;
        var axisMin = Math.max(0, allMin - pad);
        var axisMax = allMax + pad;
        var axisRange = axisMax - axisMin;

        var bucketWidth = parseInt(document.getElementById('bucket-width').value) || 3;
        var selectedSlot = Math.floor(selectedHour / bucketWidth) * bucketWidth;

        // Y-axis ticks (3 ticks: bottom, mid, top)
        var yTicks = [axisMax, (axisMin + axisMax) / 2, axisMin];
        var yHtml = '<div class="time-chart-yaxis">';
        yTicks.forEach(function (v) {
            yHtml += '<div class="time-chart-ytick">' + fmtMins(v) + '</div>';
        });
        yHtml += '</div>';

        // Bars
        var barsHtml = '<div class="time-chart-bars">';
        data.forEach(function (d) {
            var pct = d.mins != null && axisRange > 0
                ? Math.max(2, ((d.mins - axisMin) / axisRange) * 100)
                : 2;
            var isActive = d.hour === selectedSlot;
            var barClass = isActive ? 'active' : 'faded';

            // Whiskers
            var rangeHtml = '';
            if (d.minMins != null && d.maxMins != null && axisRange > 0 && d.minMins !== d.maxMins) {
                var wBot = ((d.minMins - axisMin) / axisRange) * 100;
                var wTop = ((d.maxMins - axisMin) / axisRange) * 100;
                rangeHtml = '<div class="time-bar-range" style="bottom:' + wBot + '%;height:' + (wTop - wBot) + '%"></div>'
                    + '<div class="time-bar-range-cap" style="bottom:' + wBot + '%"></div>'
                    + '<div class="time-bar-range-cap" style="bottom:' + wTop + '%"></div>';
            }

            barsHtml += '<div class="time-bar-wrap" data-hour="' + d.hour + '" title="' + fmtMins(d.mins) + '">'
                + rangeHtml
                + '<div class="time-bar ' + barClass + '" style="height:' + pct + '%"></div>'
                + '</div>';
        });
        barsHtml += '</div>';

        // X-axis ticks
        var xHtml = '<div class="time-chart-xaxis">';
        data.forEach(function (d) {
            xHtml += '<div class="time-chart-xtick">' + String(d.hour).padStart(2, '0') + '</div>';
        });
        xHtml += '</div>';

        var html = '<div class="time-chart">'
            + '<div class="time-chart-label">Predicted travel time</div>'
            + '<div class="time-chart-area">'
            + yHtml
            + '<div class="time-chart-body">' + barsHtml + xHtml + '</div>'
            + '</div></div>';
        container.innerHTML = html;

        // Click a bar to select that departure time
        container.querySelectorAll('.time-bar-wrap').forEach(function (el) {
            el.addEventListener('click', function () {
                var h = parseInt(el.dataset.hour);
                var daySel = document.getElementById('depart-day');
                if (!daySel.value) {
                    // Set to today's day-of-week
                    daySel.value = new Date().getDay();
                    document.getElementById('depart-hour').disabled = false;
                }
                document.getElementById('depart-hour').value = h;
                window.getRoute();
            });
        });
    }

}());
</script>
}
