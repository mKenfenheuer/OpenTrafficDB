{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=opentrafficdb;Username=opentraffic;Password=changeme"
  },
  "Security": {
    "MaxTimestampDriftSeconds": 300,
    "MaxGpsAccuracyMeters": 25.0,
    "WarnGpsAccuracyMeters": 50.0,
    "MaxSpeedMs": 111.11,
    "SubmitRateLimitPerMinutePerIp": 120,
    "SubmitRateLimitPerMinutePerKey": 200,
    "ReadRateLimitPerMinutePerIp": 30,
    "ReadRateLimitPerMinutePerKey": 60,
    "RegisterRateLimitPerHourPerIp": 5,
    "ContributorThreshold": 100
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient":"Error"
    }
  },
  "Jwt": {
    "Key": "change-me-to-a-secure-key-at-least-32-chars-long"
  },
  "Workers": {
    "Ingest": {
      "Urls": [ "http://localhost:5100" ]
    },
    "Aggregate": {
      "Urls": [ "http://localhost:5101" ]
    },
    "Routing": {
      "Urls": [ "http://localhost:5102" ]
    }
  },
  "Coordinator": {
    "ChunkSize": 750,
    "IntervalSeconds": 15
  },
  "AllowedHosts": "*",
  "BaseUrl": "https://opentrafficdb.ksol.it",
  "Email": {
    "SmtpHost": "localhost",
    "SmtpPort": "25",
    "SmtpUser": "",
    "SmtpPassword": "",
    "EnableSsl": false,
    "FromAddress": "opentrafficdb@ksol.it",
    "FromName": "OpenTrafficDB"
  }
}
