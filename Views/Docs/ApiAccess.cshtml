@{
    Layout = "~/Views/Docs/_DocsLayout.cshtml";
    ViewData["Title"] = "API Access";
    ViewData["DocsPage"] = "api-access";
}

<h1 style="font-size:1.75rem;font-weight:800;margin-bottom:8px">API Access</h1>
<p class="text-muted" style="margin-bottom:32px">Authentication, endpoint reference, rate limits, and error codes.</p>

<div class="card section">
    <div class="card-title">Authentication</div>
    <p class="text-muted text-sm" style="line-height:1.8;margin-bottom:12px">
        Every API request must include your API key as a Bearer token:
    </p>
    <div class="code-block">Authorization: Bearer &lt;your-api-key&gt;</div>
    <p class="text-muted text-sm" style="line-height:1.8;margin-top:12px">
        Create and manage API keys on your <a href="/Home/Profile">Profile</a> page. Each key is shown only once and stored as a hash — keep it safe. You can create multiple keys (e.g. one per device) and revoke them individually.
    </p>
</div>

<div class="card section">
    <div class="card-title">Observation Endpoints</div>

    <div style="margin-bottom:20px">
        <div style="font-size:0.8rem;font-weight:600;color:var(--text-muted);margin-bottom:6px">POST /api/v1/speed</div>
        <p class="text-muted text-sm" style="line-height:1.8">Submit a single GPS speed observation. Not rate-limited — blocked IPs are rejected with 403.</p>
        <div class="code-block"><span class="code-val">{
    "tripId":            "string (UUID, anonymized per-trip identifier)",
    "latitude":          -90.0 … 90.0,
    "longitude":         -180.0 … 180.0,
    "speedMs":           0.0 … 200.0,
    "gpsAccuracyMeters": 0.01 … 10000.0,
    "timestamp":         "ISO 8601 UTC",
    "heading":           0.0 … 360.0,       <span class="code-comment">// optional</span>
    "altitudeMeters":    -500 … 15000        <span class="code-comment">// optional</span>
}</span></div>
        <p class="text-muted text-sm" style="line-height:1.8;margin-top:8px">
            Returns: <code>{"success": true, "observationId": 12345, "warning": null}</code>
        </p>
    </div>

    <div>
        <div style="font-size:0.8rem;font-weight:600;color:var(--text-muted);margin-bottom:6px">POST /api/v1/speed/batch</div>
        <p class="text-muted text-sm" style="line-height:1.8">Submit up to 100 observations in one request. Not rate-limited. Invalid observations are rejected individually; valid ones are still accepted.</p>
        <div class="code-block"><span class="code-val">{
    "observations": [ ... ]  <span class="code-comment">// 1–100 SpeedObservationRequest objects</span>
}</span></div>
        <p class="text-muted text-sm" style="line-height:1.8;margin-top:8px">
            Returns: <code>{"accepted": 98, "rejected": 2, "errors": ["[trip xyz]: ..."]}</code>
        </p>
    </div>
</div>

<div class="card section">
    <div class="card-title">Traffic Endpoints</div>

    <div style="margin-bottom:20px">
        <div style="font-size:0.8rem;font-weight:600;color:var(--text-muted);margin-bottom:6px">GET /api/v1/traffic/live</div>
        <p class="text-muted text-sm" style="line-height:1.8">Query real-time speed observations within a bounding box (max 1° × 1°). Rate-limited.</p>
        <div class="code-block"><span class="code-url">GET /api/v1/traffic/live?minLat=48.8&maxLat=48.9&minLon=2.3&maxLon=2.4&maxAgeMinutes=15</span></div>
        <div class="table-wrap" style="margin-top:8px">
            <table style="font-size:0.8rem;width:100%;border-collapse:collapse">
                <thead><tr style="border-bottom:1px solid var(--border)">
                    <th style="text-align:left;padding:4px 8px;color:var(--text-muted)">Parameter</th>
                    <th style="text-align:left;padding:4px 8px;color:var(--text-muted)">Type</th>
                    <th style="text-align:left;padding:4px 8px;color:var(--text-muted)">Description</th>
                </tr></thead>
                <tbody class="text-muted">
                    <tr><td style="padding:4px 8px"><code>minLat</code>, <code>maxLat</code></td><td style="padding:4px 8px">double</td><td style="padding:4px 8px">Latitude bounds (-90 … 90)</td></tr>
                    <tr><td style="padding:4px 8px"><code>minLon</code>, <code>maxLon</code></td><td style="padding:4px 8px">double</td><td style="padding:4px 8px">Longitude bounds (-180 … 180)</td></tr>
                    <tr><td style="padding:4px 8px"><code>maxAgeMinutes</code></td><td style="padding:4px 8px">int (1–60)</td><td style="padding:4px 8px">Max age of observations (default: 15)</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <div style="margin-bottom:20px">
        <div style="font-size:0.8rem;font-weight:600;color:var(--text-muted);margin-bottom:6px">GET /api/v1/traffic/predicted/csv</div>
        <p class="text-muted text-sm" style="line-height:1.8">
            Download a Valhalla-compatible predicted traffic CSV with 2016 time buckets per way. Rate-limited.
            See <a href="/docs/valhalla">Valhalla Integration</a> for details.
        </p>
    </div>

    <div>
        <div style="font-size:0.8rem;font-weight:600;color:var(--text-muted);margin-bottom:6px">GET /api/v1/traffic/predicted/tar</div>
        <p class="text-muted text-sm" style="line-height:1.8">
            Download a <code>traffic.tar</code> archive pre-organised in Valhalla's tile folder hierarchy. Rate-limited.
            The archive mirrors Valhalla's tile structure (<code>{level}/{tile_id/1000:D3}/{tile_id%1000:D3}.csv</code>),
            so it can be extracted directly and passed to <code>valhalla_add_predicted_traffic</code> without
            any post-processing:
        </p>
        <div class="code-block"><span class="code-comment"># extract, then import</span>
tar -xf traffic.tar -C /path/to/traffic_tiles/
valhalla_add_predicted_traffic --config valhalla.json -t /path/to/traffic_tiles/</div>
        <p class="text-muted text-sm" style="line-height:1.8;margin-top:8px">
            Use this endpoint instead of <code>/csv</code> when your Valhalla build expects per-tile files rather than a single flat CSV.
        </p>
    </div>
</div>

<div class="card section">
    <div class="card-title">Rate Limits</div>
    <p class="text-muted text-sm" style="line-height:1.8;margin-bottom:12px">
        Submission endpoints (<code>/speed</code>, <code>/speed/batch</code>) are <strong style="color:var(--text)">not rate-limited</strong>.
        Read endpoints are rate-limited per IP and per key:
    </p>
    <div class="table-wrap" style="font-size:0.82rem">
        <table style="width:100%;border-collapse:collapse">
            <thead><tr style="border-bottom:1px solid var(--border)">
                <th style="text-align:left;padding:6px 8px;color:var(--text-muted)">Endpoint group</th>
                <th style="text-align:left;padding:6px 8px;color:var(--text-muted)">Per IP / min</th>
                <th style="text-align:left;padding:6px 8px;color:var(--text-muted)">Per key / min</th>
            </tr></thead>
            <tbody class="text-muted">
                <tr style="border-bottom:1px solid var(--border)">
                    <td style="padding:6px 8px">Submission (<code>/speed</code>, <code>/speed/batch</code>)</td>
                    <td style="padding:6px 8px">No limit</td>
                    <td style="padding:6px 8px">No limit</td>
                </tr>
                <tr>
                    <td style="padding:6px 8px">Read/export (<code>/traffic/*</code>)</td>
                    <td style="padding:6px 8px">30</td>
                    <td style="padding:6px 8px">60</td>
                </tr>
            </tbody>
        </table>
    </div>
    <p class="text-muted text-sm" style="line-height:1.8;margin-top:12px">
        IPs that trigger abuse detection are automatically blocked for 24 hours and receive <code>403 Forbidden</code>.
        Rate limit exceeded responses return <code>429 Too Many Requests</code>.
    </p>
</div>

<div class="card section">
    <div class="card-title">Error Codes</div>
    <div class="table-wrap" style="font-size:0.82rem">
        <table style="width:100%;border-collapse:collapse">
            <thead><tr style="border-bottom:1px solid var(--border)">
                <th style="text-align:left;padding:6px 8px;color:var(--text-muted)">Status</th>
                <th style="text-align:left;padding:6px 8px;color:var(--text-muted)">Meaning</th>
            </tr></thead>
            <tbody class="text-muted">
                <tr style="border-bottom:1px solid var(--border)"><td style="padding:6px 8px"><code>200</code></td><td style="padding:6px 8px">Success</td></tr>
                <tr style="border-bottom:1px solid var(--border)"><td style="padding:6px 8px"><code>400</code></td><td style="padding:6px 8px">Validation error — check the request body fields</td></tr>
                <tr style="border-bottom:1px solid var(--border)"><td style="padding:6px 8px"><code>401</code></td><td style="padding:6px 8px">Missing or invalid API key</td></tr>
                <tr style="border-bottom:1px solid var(--border)"><td style="padding:6px 8px"><code>403</code></td><td style="padding:6px 8px">IP blocked due to abuse detection</td></tr>
                <tr style="border-bottom:1px solid var(--border)"><td style="padding:6px 8px"><code>404</code></td><td style="padding:6px 8px">Resource not found</td></tr>
                <tr style="border-bottom:1px solid var(--border)"><td style="padding:6px 8px"><code>409</code></td><td style="padding:6px 8px">Conflict (e.g. email already in use)</td></tr>
                <tr style="border-bottom:1px solid var(--border)"><td style="padding:6px 8px"><code>429</code></td><td style="padding:6px 8px">Rate limit exceeded on read endpoints</td></tr>
                <tr><td style="padding:6px 8px"><code>500</code></td><td style="padding:6px 8px">Internal server error</td></tr>
            </tbody>
        </table>
    </div>
</div>

<div class="card section">
    <div class="card-title">Interactive API Explorer</div>
    <p class="text-muted text-sm" style="line-height:1.8">
        The full OpenAPI specification is available via Swagger UI.
        Authorize with your API key (paste it into the Bearer field) and try requests directly in the browser.
    </p>
    <div style="margin-top:12px">
        <a href="/swagger" target="_blank" class="btn btn-secondary btn-sm">Open Swagger UI →</a>
    </div>
</div>
