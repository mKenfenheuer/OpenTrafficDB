<div class="card section">
    <div class="card-title">Python — Continuous Submission</div>
    <p class="text-muted text-sm" style="line-height:1.8;margin-bottom:12px">
        A minimal Python script that reads GPS fixes from a serial NMEA device and submits them in batches:
    </p>
    <div class="code-block"><span class="code-comment">import requests, uuid, time, datetime

API_BASE = "https://opentrafficdb.example.com/api/v1"
API_KEY  = "&lt;your-api-key&gt;"
TRIP_ID  = str(uuid.uuid4())  # generate once per trip

session = requests.Session()
session.headers.update({"Authorization": f"Bearer {API_KEY}"})

def submit_batch(observations):
    r = session.post(f"{API_BASE}/speed/batch",
                     json={"observations": observations}, timeout=10)
    r.raise_for_status()
    return r.json()

buffer = []
for fix in read_gps_fixes():          # your GPS source
    buffer.append({
        "tripId":            TRIP_ID,
        "latitude":          fix.lat,
        "longitude":         fix.lon,
        "speedMs":           fix.speed_ms,
        "gpsAccuracyMeters": fix.accuracy,
        "heading":           fix.heading,
        "timestamp":         fix.utc.isoformat() + "Z",
    })
    if len(buffer) >= 50:
        result = submit_batch(buffer)
        print(f"Accepted: {result['accepted']}, Rejected: {result['rejected']}")
        buffer.clear()
    time.sleep(1)</span></div>
</div>

<div class="card section">
    <div class="card-title">Python — Download and Import Traffic</div>
    <div class="code-block"><span class="code-comment">import requests, subprocess, tempfile, os

API_BASE = "https://opentrafficdb.example.com/api/v1"
API_KEY  = "&lt;your-api-key&gt;"

# Download CSV
r = requests.get(f"{API_BASE}/traffic/predicted/csv",
                 headers={"Authorization": f"Bearer {API_KEY}"}, stream=True)
r.raise_for_status()

with tempfile.NamedTemporaryFile(suffix=".csv", delete=False) as f:
    for chunk in r.iter_content(chunk_size=65536):
        f.write(chunk)
    csv_path = f.name

# Import into Valhalla
subprocess.run([
    "valhalla_add_predicted_traffic",
    "--config", "/etc/valhalla/valhalla.json",
    "-t", csv_path,
], check=True)
os.unlink(csv_path)
print("Traffic data imported.")</span></div>
</div>

