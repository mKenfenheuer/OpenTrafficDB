<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] – OpenTrafficDB</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <nav class="navbar">
        <div class="container navbar-inner">
            <a href="/" class="navbar-brand">
                OpenTrafficDB
            </a>
            <button class="navbar-toggle" id="nav-toggle" aria-label="Toggle navigation" onclick="toggleNav()">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
            </button>
            <ul class="navbar-nav" id="navbar-links">
                @RenderSection("Navbar", required: false)
                <li><a href="/map/traffic">Map</a></li>
                <li><a href="/docs">Docs</a></li>
                <li><a href="/swagger" target="_blank">API</a></li>
                @if(User.Identity?.IsAuthenticated == true) {
                    <li><a href="/Home/Dashboard">Dashboard</a></li>
                    <li><a href="/Home/Profile">Profile</a></li>
                }
                @if(User.Claims.Any(c => c.Type == "role" && c.Value == "Admin"))
                {
                    <li><a href="/Home/Admin">Admin</a></li>
                }
                @if(User.Identity?.IsAuthenticated == true) {
                    <li><button class="btn btn-secondary btn-sm" onclick="logout()">Sign Out</button></li>
                } else {
                    <li><a class="btn btn-secondary btn-sm" href="/Home/Login">Sign In</a></li>
                }
            </ul>
        </div>
    </nav>

    <div class="container" style="padding-top:32px;padding-bottom:64px;flex:1">
        @RenderBody()
    </div>
    <footer>
        <div class="container">
            <p>OpenTrafficDB · <a href="/swagger" target="_blank">API Docs</a> · <a href="/">Home</a> · <a href="/Home/License">License</a> · <a href="/Home/Privacy">Privacy</a> · <a href="/Home/Imprint">Imprint</a></p>
        </div>
    </footer>

    <!-- Cookie notice (technically necessary cookies only, no consent required) -->
    <div id="cookie-banner" style="display:none;position:fixed;bottom:0;left:0;right:0;background:var(--surface);border-top:1px solid var(--border);z-index:200;padding:14px 0">
        <div class="container" style="display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap">
            <p style="font-size:0.82rem;color:var(--text-muted);margin:0">
                This site uses only strictly necessary cookies for login. No tracking or analytics cookies are used.
                <a href="/Home/Privacy" style="white-space:nowrap">Privacy Policy</a>
            </p>
            <button onclick="dismissCookieBanner()" class="btn btn-secondary btn-sm" style="flex-shrink:0">Got it</button>
        </div>
    </div>

    @RenderSection("Scripts", required: false)
    <script>
        // Fallback logout for pages that don't import app.js (e.g. docs pages)
        if (typeof window.logout === 'undefined') {
            window.logout = async function() {
                await fetch('/auth/logout', { method: 'POST', credentials: 'same-origin' });
                window.location.href = '/';
            };
        }
        function toggleNav() {
            document.getElementById('navbar-links').classList.toggle('open');
        }
        document.addEventListener('click', function(e) {
            var nav = document.getElementById('navbar-links');
            var toggle = document.getElementById('nav-toggle');
            if (nav && nav.classList.contains('open') && !nav.contains(e.target) && !toggle.contains(e.target)) {
                nav.classList.remove('open');
            }
        });
        function dismissCookieBanner() {
            document.getElementById('cookie-banner').style.display = 'none';
            localStorage.setItem('cookieNoticeAck', '1');
        }
        if (!localStorage.getItem('cookieNoticeAck')) {
            document.getElementById('cookie-banner').style.display = '';
        }
    </script>
</body>

</html>